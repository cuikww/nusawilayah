{
  "name": "@nusawilayah/react",
  "version": "0.4.0",
  "description": "React <WilayahPicker> component and useWilayah hook for picking Indonesian regions",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@nusawilayah/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuikww/nusawilayah.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/cuikww/nusawilayah#readme",
  "bugs": "https://github.com/cuikww/nusawilayah/issues",
  "keywords": [
    "indonesia",
    "wilayah",
    "provinsi",
    "kabupaten",
    "kecamatan",
    "desa",
    "kelurahan",
    "kode pos",
    "kemendagri",
    "region picker",
    "address"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
