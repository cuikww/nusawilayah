{
  "name": "@nusawilayah/core",
  "version": "0.3.0",
  "description": "Headless Indonesian region picker client: on-demand data loading, cache, search and cascading state",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuikww/nusawilayah.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cuikww/nusawilayah#readme",
  "bugs": "https://github.com/cuikww/nusawilayah/issues",
  "keywords": [
    "indonesia",
    "wilayah",
    "provinsi",
    "kabupaten",
    "kecamatan",
    "desa",
    "kelurahan",
    "kode pos",
    "kemendagri",
    "region picker",
    "address"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
