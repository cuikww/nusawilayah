{
  "name": "@nusawilayah/map-react",
  "version": "0.1.0",
  "description": "React <PetaIndonesia> map of Indonesian regions: choropleth, click to select, keyboard accessible",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@nusawilayah/geo": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuikww/nusawilayah.git",
    "directory": "packages/map-react"
  },
  "bugs": "https://github.com/cuikww/nusawilayah/issues",
  "keywords": [
    "indonesia",
    "peta",
    "map",
    "react",
    "svg",
    "choropleth",
    "provinsi",
    "kabupaten",
    "kecamatan"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
