{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {},
    "@nusawilayah/data#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pipeline/*.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
